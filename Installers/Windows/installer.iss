; Script generated by the Inno Setup Script Wizard.
; Updated to install both VST3 and CLAP formats.

#ifndef MyAppName
    #define MyAppName "Chroma"
#endif
#ifndef MyAppVersion
    #define MyAppVersion "1.1.1"
#endif
#ifndef MyAppPublisher
    #define MyAppPublisher "Xynth Audio"
#endif
#ifndef MyAppURL
    #define MyAppURL "https://www.xynth.audio/"
#endif
#ifndef MyOutputName
    #define MyOutputName "Chroma Installer"
#endif

[Setup]
AppId={{A4DC55BD-186B-4F88-9D98-6194BB9BE1F6}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; We keep DefaultDirName pointed at the standard VST3 directory.
; (The CLAP file is installed to its own standard directory explicitly in [Files].)
DefaultDirName={commoncf64}\VST3
DisableDirPage=yes

DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes

LicenseFile=..\Common\License.rtf
InfoBeforeFile=..\Common\Before Install.rtf
InfoAfterFile=..\Common\After Install.rtf

OutputDir=.\
OutputBaseFilename={#MyOutputName}
Compression=lzma
SolidCompression=yes
WizardStyle=modern

; Ensure we install to 64-bit Program Files\Common Files
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

; Optional: clean up the legacy VST3 folder location before copying the new one
[InstallDelete]
Type: filesandordirs; Name: {commoncf64}\VST3\{#MyAppName}.vst3

; Let users pick which formats to install (both checked by default).
[Tasks]
Name: "install_vst3"; Description: "Install VST3 plug-in"; GroupDescription: "Plugin formats:"
Name: "install_clap"; Description: "Install CLAP plug-in"; GroupDescription: "Plugin formats:"

[Files]
; VST3: copy the entire .vst3 bundle folder (recurse)
; Source folder should contain the bundle "Chroma.vst3" (a directory on Windows)
Source: "Manual Install\{#MyAppName}.vst3\*"; \
    DestDir: "{commoncf64}\VST3\{#MyAppName}.vst3"; \
    Flags: ignoreversion recursesubdirs; \
    Tasks: install_vst3

; CLAP: copy the single .clap file to the Common Files\CLAP directory
; Ensure your build outputs the single file at the Source path below.
Source: "Manual Install\{#MyAppName}.clap"; \
    DestDir: "{commoncf64}\CLAP"; \
    Flags: ignoreversion; \
    Tasks: install_clap
